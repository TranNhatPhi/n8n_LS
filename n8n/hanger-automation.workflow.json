{
  "id": "HangerUploadDirect01",
  "name": "Hanger Automation - Upload trực tiếp",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Kiểm tra Hanger",
        "formDescription": "Tải lên 1 file đơn hàng và một hoặc nhiều file SOF tương ứng (.xls hoặc .xlsx, tối đa 20 SOF). Rule được ưu tiên; DeepSeek hỗ trợ các dòng chưa phân loại khi đã bật trong .env. File gốc không bị chỉnh sửa.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "File đơn hàng",
              "fieldName": "order_workbook",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".xls,.xlsx",
              "requiredField": true
            },
            {
              "fieldLabel": "Các file SOF tương ứng",
              "fieldName": "sof_workbook",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".xls,.xlsx",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "buttonLabel": "Kiểm tra và tạo file kết quả"
        }
      },
      "id": "9bf86a37-54ff-4d11-9565-f55c25929c64",
      "name": "Upload Order và SOF",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -576,
        0
      ],
      "webhookId": "f63ddfc0-8c14-4f22-9791-d13d5f6bc379"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary ?? {};\nconst order = binary.order_workbook;\nif (!order) throw new Error('Thiếu file đơn hàng');\nif (!/\\.xlsx?$/i.test(String(order.fileName ?? ''))) throw new Error('File đơn hàng phải là .xls hoặc .xlsx');\nconst sofKeys = Object.keys(binary).filter((key) => key === 'sof_workbook' || /^sof_workbook_\\d+$/.test(key));\nsofKeys.sort((a, b) => {\n  if (a === 'sof_workbook') return -1;\n  if (b === 'sof_workbook') return 1;\n  return Number(a.split('_').pop()) - Number(b.split('_').pop());\n});\nif (sofKeys.length === 0) throw new Error('Cần tải lên ít nhất 1 file SOF');\nif (sofKeys.length > 20) throw new Error('Chỉ được tải tối đa 20 file SOF mỗi lần');\nconst names = new Set();\nfor (const key of sofKeys) {\n  const name = String(binary[key]?.fileName ?? '');\n  if (!/\\.xlsx?$/i.test(name)) throw new Error(`SOF ${name || key} phải là file .xls hoặc .xlsx`);\n  const normalized = name.toLocaleLowerCase();\n  if (names.has(normalized)) throw new Error(`Trùng tên file SOF: ${name}`);\n  names.add(normalized);\n}\nreturn [{json: {overwrite: false, sofBinaryFields: sofKeys.join(','), sofCount: sofKeys.length}, binary}];"
      },
      "id": "2b0ea8a7-5c58-4289-b872-447f1f1a9607",
      "name": "Validate Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        0
      ]
    },
    {
      "parameters": {
        "operation": "compress",
        "binaryPropertyName": "={{ $json.sofBinaryFields }}",
        "outputFormat": "zip",
        "fileName": "sof-files.zip",
        "binaryPropertyOutput": "sof_archive"
      },
      "id": "e6b1bf9a-9f97-41e6-922c-066531679aaa",
      "name": "Đóng gói các SOF",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        -96,
        -96
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "2ac66da2-e503-4820-bf51-d46fbb15615b",
      "name": "Ghép đơn hàng và SOF",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        144,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hanger-worker:8080/run-upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "order_workbook",
              "inputDataFieldName": "order_workbook"
            },
            {
              "parameterType": "formBinaryData",
              "name": "sof_archive",
              "inputDataFieldName": "sof_archive"
            },
            {
              "name": "overwrite",
              "value": "={{ String($json.overwrite) }}"
            }
          ]
        },
        "options": {
          "timeout": 3600000
        }
      },
      "id": "0d5d6c0f-ab43-4d62-a462-a1f7f5143d30",
      "name": "Gửi File tới Hanger Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        384,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const audit = $input.first().json;\nif (audit.status === 'ERROR') throw new Error(audit.error || 'Hanger worker failed');\nreturn [{json: {...audit, needsAttention: Number(audit.mismatch || 0) + Number(audit.review || 0) > 0}}];"
      },
      "id": "20d13068-4e9f-401e-826e-4bb485ff8c64",
      "name": "Evaluate Audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "5ce23634-7a6a-4720-ab27-419424426138",
              "leftValue": "={{ $json.needsAttention }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c5a79ed0-3613-4fd2-958b-36eaac9a2f98",
      "name": "Needs Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        864,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json}) => {\n  const llm = json.llm?.enabled ? ` DeepSeek: ${json.llm.api_calls || 0} call, cache hit ${json.llm.cache?.hits ?? 0}.` : ' DeepSeek: tắt.';\n  const scope = `Đã kiểm account: ${(json.accounts_checked || []).join(', ') || 'không có'}.`;\n  const out = json.skipped_no_sof ? ` Bỏ qua ${json.skipped_no_sof} dòng của account chưa gửi SOF.` : '';\n  return {json: {...json, status: 'COMPLETED_WITH_REVIEW',\n    message: `${scope} Trong ${json.total_checked_rows} dòng: matched ${json.matched}, mismatch ${json.mismatch}, review ${json.review}.${out}${llm}`}};\n});"
      },
      "id": "45ef29a8-3190-4afb-8a31-cf86f172f7a6",
      "name": "Review Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json}) => {\n  const llm = json.llm?.enabled ? ` DeepSeek: ${json.llm.api_calls || 0} call, cache hit ${json.llm.cache?.hits ?? 0}.` : ' DeepSeek: tắt.';\n  const scope = `Đã kiểm account: ${(json.accounts_checked || []).join(', ') || 'không có'}.`;\n  const out = json.skipped_no_sof ? ` Bỏ qua ${json.skipped_no_sof} dòng của account chưa gửi SOF.` : '';\n  return {json: {...json, status: 'COMPLETED',\n    message: `${scope} ${json.matched}/${json.total_checked_rows} dòng matched.${out}${llm}`}};\n});"
      },
      "id": "6349a1d8-1797-42d1-870c-c65bab17925b",
      "name": "Success Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        96
      ]
    },
    {
      "parameters": {
        "url": "=http://hanger-worker:8080/result?file={{ encodeURIComponent($json.result_file_name) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 120000
        }
      },
      "id": "d4f8a1c6-5b93-4e72-9a18-6c2f0b7e3d55",
      "name": "Tải File Kết Quả",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1344,
        380
      ]
    }
  ],
