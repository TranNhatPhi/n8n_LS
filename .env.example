# Pin the tested n8n release. Review release notes before changing this value.
N8N_VERSION=2.38.7
N8N_PORT=5678

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_VALUE

# Maximum number of SOF workbooks accepted in one form submission.
HANGER_MAX_SOF_FILES=20

# Optional DeepSeek fallback for rows that have no approved deterministic rule.
# Keep disabled until DEEPSEEK_API_KEY is configured locally.
HANGER_LLM_ENABLED=false
# Extra keys run batches in parallel. Comma-separate DEEPSEEK_API_KEY, or
# use the numbered slots DEEPSEEK_API_KEY_2..9.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_2=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
HANGER_LLM_BATCH_SIZE=12
HANGER_LLM_MAX_CALLS=20
HANGER_LLM_MAX_EVIDENCE_CHARS=45000
HANGER_LLM_MIN_CONFIDENCE=0.85
# So request gui song song. Khong lien quan so API key.
HANGER_LLM_CONCURRENCY=8
